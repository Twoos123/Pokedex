{
  "version": 2,
  "builds": [
    {
      "src": "server/package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["../pokedata/**", "index.js"]
      }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "build"
      }
    }
  ],
  "rewrites": [
    { "source": "/graphql", "destination": "/server" },
    { "source": "/api/pokemon", "destination": "/server" },
    { "source": "/static/(.*)", "destination": "/client/static/$1" },
    { "source": "/(.*)", "destination": "/client/index.html" }
  ]
}