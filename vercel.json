{
  "version": 2,
  "builds": [
    {
      "src": "server/package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["../pokedata/**", "index.js"]
      }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { 
        "outputDirectory": "build"
      }
    }
  ],
  "rewrites": [
    { "source": "/graphql", "destination": "/server/index.js" },
    { "source": "/api/pokemon", "destination": "/server/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}